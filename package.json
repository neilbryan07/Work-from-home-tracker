{
  "name": "611testtracker",
  "version": "1.0.0",
  "description": "Tracker for 611 User",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "watch": "nodemon --watch main.js --exec \"electron .\"",
    "package-mac": "electron-packager . --overwrite --platform=darwin --arch=x64 --icon=assets/icons/mac/icon.icns --prune=true --out=release-builds",
    "package-win": "electron-packager . --overwrite --asar --platform=win32 --arch=ia32 --icon=assets/icons/win/icon.ico --prune=true --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"NBPO Tracker\"",
    "package-linux": "electron-packager . --overwrite --asar --platform=linux --arch=x64 --icon=assets/icons/linux/icon.png --prune=true --out=release-builds",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "611 Team",
  "license": "ISC",
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "dependencies": {
    "axios": "^0.26.1",
    "crypto-js": "^4.0.0",
    "custom-env": "^2.0.1",
    "electron-store": "^5.1.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^8.2.3",
    "electron-builder": "^25.1.8",
    "electron-packager": "^14.2.1",
    "electron-rebuild": "^3.2.9",
    "electron-wix-msi": "^2.2.0",
    "nodemon": "^3.1.9"
  },
  "build": {
    "appId": "com.time_tracker.611",
    "productName": "611 Time Tracker 5 mins SS",
    "copyright": "Copyright © 2025 611",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": "nsis",
      "icon": "assets/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/win/icon.ico",
      "uninstallerIcon": "assets/icons/win/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "icon": "assets/icons/win/icon.ico"
  }
}
